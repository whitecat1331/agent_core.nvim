# Enforce consistent line endings so shell scripts always run on WSL/Linux and
# so git diffs stay clean across Windows (Cursor) and WSL (nvim) checkouts.
* text=auto

*.sh text eol=lf
*.lua text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.editorconfig text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
